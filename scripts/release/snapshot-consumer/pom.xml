<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-dependencies</artifactId>
        <version>@forge.version@</version>
        <relativePath/>
    </parent>
    <groupId>smoke</groupId>
    <artifactId>snapshot-consumer</artifactId>
    <version>1.0.0</version>
    <repositories>
        <repository>
            <id>forge-release</id>
            <url>@forge.repository@</url>
            <snapshots><enabled>true</enabled><updatePolicy>always</updatePolicy></snapshots>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-provisioning</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
