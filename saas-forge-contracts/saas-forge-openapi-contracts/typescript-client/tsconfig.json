{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "target/generated",
    "skipLibCheck": true
  },
  "include": [
    "target/generated/**/*.ts"
  ]
}
