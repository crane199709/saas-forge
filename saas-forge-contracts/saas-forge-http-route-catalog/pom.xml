<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.crane199709</groupId>
        <artifactId>saas-forge</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>saas-forge-http-route-catalog</artifactId>
    <name>saas-forge-http-route-catalog</name>

    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
        <route-catalog.registry-overlay>-</route-catalog.registry-overlay>
        <route-catalog.openapi-overlay>-</route-catalog.openapi-overlay>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser-v3</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/route-catalog</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-http-route-catalog</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--class-path</argument>
                                <classpath/>
                                <argument>${project.basedir}/src/codegen/java/HttpRouteCatalogGenerator.java</argument>
                                <argument>${maven.multiModuleProjectDirectory}</argument>
                                <argument>${project.build.directory}/generated-resources/route-catalog/META-INF/saas.forge/http-route-catalog.json</argument>
                                <argument>${route-catalog.registry-overlay}</argument>
                                <argument>${route-catalog.openapi-overlay}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>platform-mechanism-acceptance</id>
            <properties>
                <route-catalog.registry-overlay>${maven.multiModuleProjectDirectory}/test-support/platform-mechanism-receiver/registry-overlay.json</route-catalog.registry-overlay>
                <route-catalog.openapi-overlay>${maven.multiModuleProjectDirectory}/test-support/platform-mechanism-receiver/openapi-overlay.yaml</route-catalog.openapi-overlay>
            </properties>
        </profile>
        <profile>
            <id>sdk-external-consumer-acceptance</id>
            <properties>
                <route-catalog.registry-overlay>${maven.multiModuleProjectDirectory}/test-support/saas-forge-external-consumer-fixture/registry-overlay.json</route-catalog.registry-overlay>
                <route-catalog.openapi-overlay>${maven.multiModuleProjectDirectory}/test-support/saas-forge-external-consumer-fixture/openapi-overlay.yaml</route-catalog.openapi-overlay>
            </properties>
        </profile>
    </profiles>
</project>
