{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/iam-sessions-revoked.v1.schema.json",
  "title": "IAM Sessions Revoked v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.iam.sessions-revoked.v1" },
        "source": { "const": "urn:saas.forge:iam-service" },
        "subject": { "$ref": "#/$defs/uuidV7" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revocationRequestId", "scope", "revokedSessionCount"],
          "properties": {
            "revocationRequestId": { "$ref": "#/$defs/uuidV7" },
            "scope": { "enum": ["TENANT", "MEMBERSHIP", "IDENTITY"] },
            "membershipId": { "$ref": "#/$defs/uuidV7" },
            "tenantId": { "$ref": "#/$defs/uuidV7" },
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "revokedSessionCount": { "type": "integer", "minimum": 0 }
          },
          "oneOf": [
            {
              "required": ["tenantId"],
              "properties": { "scope": { "const": "TENANT" } },
              "not": { "anyOf": [{ "required": ["membershipId"] }, { "required": ["identityId"] }] }
            },
            {
              "required": ["membershipId"],
              "properties": { "scope": { "const": "MEMBERSHIP" } },
              "not": { "anyOf": [{ "required": ["tenantId"] }, { "required": ["identityId"] }] }
            },
            {
              "required": ["identityId"],
              "properties": { "scope": { "const": "IDENTITY" } },
              "not": { "anyOf": [{ "required": ["tenantId"] }, { "required": ["membershipId"] }] }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
