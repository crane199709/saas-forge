{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/iam-password-recovered.v1.schema.json",
  "title": "IAM Password Recovered v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.iam.password.recovered.v1" },
        "source": { "const": "urn:saas.forge:iam-service" },
        "subject": { "$ref": "#/$defs/uuidV7" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityId", "challengeId", "credentialId", "occurredAt"],
          "properties": {
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "challengeId": { "$ref": "#/$defs/uuidV7" },
            "credentialId": { "$ref": "#/$defs/uuidV7" },
            "occurredAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
