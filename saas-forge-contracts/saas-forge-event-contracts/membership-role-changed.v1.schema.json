{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/membership-role-changed.v1.schema.json",
  "title": "Membership Role Changed v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.membership-role.changed.v1" },
        "source": { "const": "urn:saas.forge:tenant-access-service" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "actorIdentityId", "membershipId", "roleId", "roleKey", "action"],
          "properties": {
            "tenantId": { "$ref": "#/$defs/uuidV7" },
            "actorIdentityId": { "$ref": "#/$defs/uuidV7" },
            "membershipId": { "$ref": "#/$defs/uuidV7" },
            "roleId": { "$ref": "#/$defs/uuidV7" },
            "roleKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
            "action": { "enum": ["ASSIGNED", "REVOKED"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
