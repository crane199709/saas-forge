{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/invitation-resent.v1.schema.json",
  "title": "Invitation Resent v1",
  "allOf": [
    {
      "$ref": "cloudevents-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "com.saas.forge.invitation.resent.v1"
        },
        "source": {
          "const": "urn:saas.forge:tenant-access-service"
        },
        "subject": {
          "$ref": "#/$defs/uuidV7"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invitationId",
            "tenantId",
            "actorIdentityId",
            "expiresAt"
          ],
          "properties": {
            "invitationId": {
              "$ref": "#/$defs/uuidV7"
            },
            "tenantId": {
              "$ref": "#/$defs/uuidV7"
            },
            "actorIdentityId": {
              "$ref": "#/$defs/uuidV7"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
