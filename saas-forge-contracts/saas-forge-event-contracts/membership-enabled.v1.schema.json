{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/membership-enabled.v1.schema.json",
  "title": "Membership Enabled v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.membership.enabled.v1" },
        "source": { "const": "urn:saas.forge:tenant-access-service" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["membershipId", "tenantId", "identityId", "actorIdentityId", "fenceReleasePending"],
          "properties": {
            "membershipId": { "$ref": "#/$defs/uuidV7" },
            "tenantId": { "$ref": "#/$defs/uuidV7" },
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "actorIdentityId": { "$ref": "#/$defs/uuidV7" },
            "fenceReleasePending": { "const": true }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
