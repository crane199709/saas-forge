{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/iam-platform-admin-granted.v1.schema.json",
  "title": "IAM Platform Admin Granted v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.iam.platform-admin-granted.v1" },
        "source": { "const": "urn:saas.forge:iam-service" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityId", "actorIdentityId", "roleAssignmentId", "roleKey", "occurredAt"],
          "properties": {
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "actorIdentityId": { "$ref": "#/$defs/uuidV7" },
            "roleAssignmentId": { "$ref": "#/$defs/uuidV7" },
            "roleKey": { "const": "PLATFORM_ADMIN" },
            "occurredAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
