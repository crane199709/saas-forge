{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/brand-asset-disabled.v1.schema.json",
  "title": "Brand Asset Disabled v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.brand.asset-disabled.v1" },
        "source": { "const": "urn:saas.forge:tenant-access-service" },
        "subject": { "$ref": "#/$defs/uuidV7" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "assetId", "actorIdentityId", "kind"],
          "properties": {
            "tenantId": { "$ref": "#/$defs/uuidV7" },
            "assetId": { "$ref": "#/$defs/uuidV7" },
            "actorIdentityId": { "$ref": "#/$defs/uuidV7" },
            "kind": { "enum": ["LOGO", "FAVICON"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
