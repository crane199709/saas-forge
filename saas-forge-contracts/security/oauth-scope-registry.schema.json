{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/security/oauth-scope-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "entries"],
  "properties": {
    "registryVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "ownerServiceId", "clientTypes", "usage", "gatewayRouteAllowed", "description"],
      "properties": {
        "scope": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$" },
        "ownerServiceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "clientTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["RESERVED_SERVICE", "RUNTIME_SERVICE", "CI_CLIENT"] }
        },
        "usage": { "enum": ["INTERNAL", "RUNTIME", "REGISTRATION"] },
        "gatewayRouteAllowed": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
