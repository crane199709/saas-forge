{
  "name": "@forge/sdk",
  "version": "0.1.0",
  "description": "SaaS Forge 前端 SDK：登录、Token 刷新、租户切换、请求拦截与权限指令",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue": "3.5.44"
  }
}
