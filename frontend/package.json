{
  "name": "saas-forge-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:platform": "pnpm --filter @forge/platform-console dev",
    "dev:tenant": "pnpm --filter @forge/tenant-app dev",
    "start:demo": "pnpm --filter @forge/demo-sub-app build && pnpm --filter @forge/demo-sub-app preview --host 127.0.0.1 --port 5175",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tools",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:spike": "VITE_FORGE_DIAGNOSTICS=true pnpm --filter @forge/tenant-app build && pnpm --filter @forge/demo-sub-app build && pnpm --filter @forge/demo-sub-app build:v2",
    "test:e2e": "playwright test",
    "test:e2e:main": "../deploy/e2e/run.sh",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "create:sub-app": "node packages/sub-app-kit/bin/create.ts --workspace"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vue/tsconfig": "0.9.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "version": "0.1.0"
}
