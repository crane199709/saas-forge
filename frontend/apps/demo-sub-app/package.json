{
  "name": "@forge/demo-sub-app",
  "version": "0.1.0",
  "private": true,
  "description": "示例 Sub-App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && vue-tsc --noEmit && vite build",
    "build:v2": "pnpm lint && vue-tsc --noEmit && vite build --mode v2 --outDir dist-v2",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "forge-sub-app-lint"
  },
  "dependencies": {
    "@crane199709/sdk": "workspace:*",
    "@crane199709/ui": "workspace:*",
    "element-plus": "2.14.7",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@crane199709/sub-app-kit": "workspace:*",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
