<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>forge-sdk-referencedata</artifactId>
    <name>Forge SDK Reference Data</name>
    <description>读取当前租户生效的 Dictionary 与 Parameter，按租户缓存并随 ReferenceDataChanged 失效</description>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- ReferenceDataChanged 事件契约；经它传递得到 forge-sdk-mq 与 RocketMQ 客户端 -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-provisioning</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 以 RestClient 读取 iam 内部接口 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- @DictionaryValue 约束；校验器实现由服务的 spring-boot-starter-validation 提供 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
