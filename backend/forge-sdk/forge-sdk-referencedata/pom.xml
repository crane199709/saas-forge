<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-sdk-referencedata</artifactId>
    <name>Forge SDK Reference Data</name>
    <description>读取当前租户生效的 Dictionary 与 Parameter，按租户缓存并按 iam 在 Redis 发布的版本号失效</description>

    <properties>
        <!-- 直接依赖变更须同步白名单与接入文档，含 optional、provided 和 test 声明。 -->
        <forge.sdk.allowedDependencies>io.saasforge:forge-architecture,
            io.saasforge:forge-sdk-core,
            jakarta.validation:jakarta.validation-api,
            org.springframework.boot:spring-boot-autoconfigure,
            org.springframework.boot:spring-boot-starter-data-redis,
            org.springframework.boot:spring-boot-starter-test,
            org.springframework.boot:spring-boot-starter-validation,
            org.springframework.data:spring-data-redis,
            org.springframework:spring-web,
            org.testcontainers:testcontainers-junit-jupiter</forge.sdk.allowedDependencies>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-core</artifactId>
        </dependency>
        <!-- 读取 iam 发布的参考数据版本号；连接由服务的 spring-boot-starter-data-redis 提供 -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 以 RestClient 读取 iam 内部接口 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- @DictionaryValue 约束；校验器实现由服务的 spring-boot-starter-validation 提供 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
