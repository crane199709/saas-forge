<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-sdk-openapi</artifactId>
    <name>Forge SDK OpenAPI</name>
    <description>springdoc 默认配置</description>

    <properties>
        <!-- 直接依赖变更须同步白名单与接入文档，含 optional、provided 和 test 声明。 -->
        <forge.sdk.allowedDependencies>io.saasforge:forge-architecture,
            org.springdoc:springdoc-openapi-starter-webmvc-api,
            org.springframework.boot:spring-boot-starter-test,
            org.springframework.boot:spring-boot-starter-webmvc</forge.sdk.allowedDependencies>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 服务只输出 /v3/api-docs，Swagger UI 由网关统一提供（ADR-0010） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>
    </dependencies>
</project>
