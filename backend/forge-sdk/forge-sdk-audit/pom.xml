<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>forge-sdk-audit</artifactId>
    <name>Forge SDK Audit</name>
    <description>@AuditLog 注解与审计事件</description>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 审计事件经 Outbox 异步投递，与业务事件共用发布、重试与幂等消费 -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-mq</artifactId>
        </dependency>
        <!-- 事件带上当前 traceId，便于从审计记录回查日志；只用 Tracer API -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
        </dependency>
    </dependencies>
</project>
