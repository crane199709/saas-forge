<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>forge-sdk-web</artifactId>
    <name>Forge SDK Web</name>
    <description>Servlet 服务的响应信封：异常映射、traceId、分页参数与 springdoc 适配</description>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-core</artifactId>
        </dependency>
        <!-- 只引入 MVC 自动配置，不替服务选择 Servlet 容器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc</artifactId>
        </dependency>
        <!-- W3C traceparent 传播与 traceId，以及 trace 与 Micrometer 指标的 OTLP 导出；配置采集端地址后才推送 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- Redis、数据库等资源故障统一以 DataAccessResourceFailureException 体系表达，据此映射 503 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- 服务引入 springdoc 时才做信封与分页参数的文档适配 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 由 Servlet 容器在运行时提供 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 过滤器抛出的异常经容器转发到 /error，只有真实容器才会走这条路径 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
