<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>forge-sdk-storage</artifactId>
    <name>Forge SDK Storage</name>
    <description>S3 协议对象存储抽象</description>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 存储容量 Quota 取自 TenantPlanChanged；对象登记经租户拦截与 RLS 隔离 -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-provisioning</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <!-- 只用同步客户端，不需要异步的 Netty 实现 -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
