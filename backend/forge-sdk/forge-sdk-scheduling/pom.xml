<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>forge-sdk-scheduling</artifactId>
    <name>Forge SDK Scheduling</name>
    <description>声明式任务调度、Redis 互斥与可观测</description>
    <properties>
        <!-- 直接依赖变更须同步白名单与接入文档，含 optional、provided 和 test 声明。 -->
        <forge.sdk.allowedDependencies>io.micrometer:micrometer-core,
            io.saasforge:forge-architecture,
            io.saasforge:forge-sdk-ops,
            io.saasforge:forge-sdk-security,
            io.saasforge:forge-sdk-tenant,
            io.saasforge:forge-sdk-web,
            org.springframework.boot:spring-boot-starter-data-redis,
            org.springframework.boot:spring-boot-starter-test,
            org.springframework.boot:spring-boot-starter-webmvc,
            org.springframework:spring-web,
            org.testcontainers:testcontainers-junit-jupiter,
            tools.jackson.core:jackson-databind</forge.sdk.allowedDependencies>
        <forkCount>2</forkCount>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-ops</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
