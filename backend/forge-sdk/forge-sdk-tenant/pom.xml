<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-sdk</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-sdk-tenant</artifactId>
    <name>Forge SDK Tenant</name>
    <description>MyBatis-Plus 租户拦截与 RLS 会话变量</description>

    <properties>
        <!-- 直接依赖变更须同步白名单与接入文档，含 optional、provided 和 test 声明。 -->
        <forge.sdk.allowedDependencies>com.baomidou:mybatis-plus-jsqlparser,
            com.baomidou:mybatis-plus-spring-boot4-starter,
            io.saasforge:forge-architecture,
            io.saasforge:forge-sdk-core,
            org.springframework.boot:spring-boot-starter-data-redis,
            org.springframework.boot:spring-boot-starter-test</forge.sdk.allowedDependencies>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- 只在服务使用 Redis 时提供带租户前缀的模板，不强迫所有服务引入 Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
