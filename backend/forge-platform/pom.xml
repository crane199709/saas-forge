<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>forge-platform</artifactId>
    <name>Forge Platform</name>
    <description>租户、套餐、Provisioning 与 App Registry 服务</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <!-- 测试类按 2 个 JVM 并行，每个 JVM 共享一个容器与 Spring 上下文；本机 Docker 4 核下 3 个反而更慢。可用 -DforkCount 调整。 -->
        <forkCount>2</forkCount>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-ops</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-architecture</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-scheduling</artifactId>
        </dependency>
        <!-- 作为 Platform Realm 服务上报 Resource Manifest，接口按 Operator 的平台角色校验功能权限与数据权限（工单 22） -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-manifest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-abac</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 创建 Tenant 时经 Outbox 发布 TenantCreated，并订阅各服务的初始化回报 -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-provisioning</artifactId>
        </dependency>
        <!-- 以 @AuditLog 审计租户的创建、状态变更与更换套餐，作为 Platform Realm 的业务操作审计 -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
