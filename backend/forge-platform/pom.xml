<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.saasforge</groupId>
        <artifactId>forge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>forge-platform</artifactId>
    <name>Forge Platform</name>
    <description>租户、套餐、Provisioning 与 App Registry 服务</description>

    <dependencies>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-openapi</artifactId>
        </dependency>
        <!-- 作为 Platform Realm 服务上报 Resource Manifest，接口按 Operator 的平台角色校验功能权限与数据权限（工单 22） -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-manifest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-abac</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 创建 Tenant 时经 Outbox 发布 TenantCreated，并订阅各服务的初始化回报 -->
        <dependency>
            <groupId>io.saasforge</groupId>
            <artifactId>forge-sdk-provisioning</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
