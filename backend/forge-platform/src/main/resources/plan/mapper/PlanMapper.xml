<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.platform.plan.mapper.PlanMapper">
    <!-- 与实体的 autoResultMap 一致：数组列经 ArrayTypeHandler 读出。 -->
    <resultMap id="plan" type="io.saasforge.platform.plan.entity.Plan" autoMapping="true">
        <result column="permissions" property="permissions" typeHandler="org.apache.ibatis.type.ArrayTypeHandler"/>
        <result column="sub_apps" property="subApps" typeHandler="org.apache.ibatis.type.ArrayTypeHandler"/>
    </resultMap>
    <select id="lockShared" resultMap="plan">
        SELECT * FROM plan WHERE id = #{id} AND NOT deleted FOR SHARE
    </select>
    <select id="lockExclusive" resultMap="plan">
        SELECT * FROM plan WHERE id = #{id} AND NOT deleted FOR UPDATE
    </select>
</mapper>
