<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 以 starter-parent 为父：继承 Boot 的依赖管理与插件默认配置，业务服务导入本 BOM 即可得到整套锁定版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>io.saasforge</groupId>
    <artifactId>forge-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Forge Dependencies</name>
    <description>SaaS Forge 版本清单（BOM），版本组合见 ADR-0013</description>

    <distributionManagement>
        <repository>
            <id>forge-release</id>
            <url>${forge.release.url}</url>
        </repository>
        <!-- 只有 publish.sh local 会部署 SNAPSHOT（临时仓库的模板冒烟）；正式发布在版本检查阶段拒绝 SNAPSHOT。 -->
        <snapshotRepository>
            <id>forge-release</id>
            <url>${forge.release.url}</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <!-- 业务服务继承 BOM 时 project.version 是业务版本，SDK 必须保持发布版本。 -->
        <forge.version>${revision}</forge.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <springdoc.version>3.0.3</springdoc.version>
        <!-- 与 Boot 4.0.9 管理的版本保持一致；显式声明是为了让 PostgreSQL 模块与 core 必然同版本 -->
        <flyway.version>11.14.1</flyway.version>
        <!-- 3.5.16 起提供 Boot 4 starter；租户拦截器在 jsqlparser 模块中，两者必须同版本（ADR-0007） -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <!-- 原生 gRPC 客户端，自带 shade 后的 grpc/netty，不与 Spring 版本耦合（ADR-0012） -->
        <rocketmq-client-java.version>5.2.2</rocketmq-client-java.version>
        <!-- 对象存储只走 S3 协议（ADR-0011），客户端用 AWS SDK for Java v2 -->
        <awssdk.version>2.39.2</awssdk.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <palantir-java-format.version>2.102.0</palantir-java-format.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-architecture</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-core</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-web</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-ops</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-security</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-tenant</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-scheduling</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-abac</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-mq</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-provisioning</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-audit</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-storage</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-numbering</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-referencedata</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-openapi</artifactId>
                <version>${forge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-manifest</artifactId>
                <version>${forge.version}</version>
            </dependency>

            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-io</artifactId>
                <version>${forge.version}</version>
            </dependency>

            <dependency>
                <groupId>io.saasforge</groupId>
                <artifactId>forge-sdk-notification</artifactId>
                <version>${forge.version}</version>
            </dependency>

            <!-- Boot 4 的 Flyway starter 不再自带数据库方言，PostgreSQL 模块必须显式引入 -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client-java</artifactId>
                <version>${rocketmq-client-java.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 格式化规则放在 BOM：平台仓库（forge-parent）与以本 BOM 为父 POM 的业务服务共用一份，
                     使用方只需在 build/plugins 声明插件坐标即可在 verify 时检查格式。
                     本模块排在 reactor 首位，命令行的 spotless: 前缀也需要在这里就能解析。 -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <removeUnusedImports/>
                            <palantirJavaFormat>
                                <version>${palantir-java-format.version}</version>
                            </palantirJavaFormat>
                        </java>
                        <formats>
                            <format>
                                <includes>
                                    <include>src/main/resources/**/*.xml</include>
                                    <include>src/test/resources/**/*.xml</include>
                                </includes>
                                <eclipseWtp>
                                    <type>XML</type>
                                    <!-- mapper 正文是手写 SQL：配置为不限行宽，否则格式化器会把 SQL 重新折行；
                                         规则文件放在工程根目录（含 .mvn 的目录） -->
                                    <files>
                                        <file>${maven.multiModuleProjectDirectory}/spotless-xml.prefs</file>
                                    </files>
                                </eclipseWtp>
                            </format>
                        </formats>
                        <pom>
                            <sortPom>
                                <nrOfIndentSpace>4</nrOfIndentSpace>
                                <expandEmptyElements>false</expandEmptyElements>
                            </sortPom>
                        </pom>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <phase>verify</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.7.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 平台版本只在 .mvn/maven.config 的 revision 维护一处；安装与发布前把 ${revision} 替换为实际版本，
                 否则仓库外工程无法解析父 POM 与 forge.version。不继承：业务服务以本 BOM 为父 POM，不需要这一步。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <phase>clean</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
