<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.demo.order.mapper.OrderAuditMapper">
    <select id="selectIncludingDeleted" resultType="io.saasforge.demo.order.entity.Order">
        <!-- 有意不排除已删除的行：测试要读出逻辑删除后的 deleted 与 updated_* -->
        SELECT id, title, amount, created_at, updated_at, created_by, updated_by, deleted FROM orders
        WHERE id = #{id}
    </select>
</mapper>
