{
  "permissions": {
    "order:read": {
      "name": "查看订单",
      "group": "订单"
    },
    "order:create": {
      "name": "创建订单",
      "group": "订单"
    },
    "order:update": {
      "name": "修改订单",
      "group": "订单"
    },
    "order:delete": {
      "name": "删除订单",
      "group": "订单"
    },
    "order:import": {
      "name": "导入订单",
      "group": "订单"
    },
    "order:importRollback": {
      "name": "回滚订单导入",
      "group": "订单"
    },
    "order:export": {
      "name": "导出订单",
      "group": "订单"
    },
    "masking:read": {
      "name": "查看脱敏样例",
      "group": "数据安全示例"
    },
    "masking:viewRaw": {
      "name": "查看样例原文",
      "group": "数据安全示例"
    },
    "masking:export": {
      "name": "导出脱敏样例",
      "group": "数据安全示例"
    }
  },
  "menus": [
    {
      "code": "demo",
      "name": "示例应用",
      "icon": "grid",
      "children": [
        {
          "code": "demo.overview",
          "name": "订单概览",
          "app": "demo",
          "path": "overview",
          "permission": "order:read",
          "actions": [
            "order:create",
            "order:update",
            "order:delete",
            "order:import",
            "order:importRollback",
            "order:export"
          ]
        },
        {
          "code": "demo.attachments",
          "name": "订单附件",
          "app": "demo",
          "path": "attachments",
          "permission": "order:read"
        }
      ]
    }
  ],
  "roles": [
    {
      "code": "order-viewer",
      "name": "订单查看员",
      "permissions": [
        "order:read"
      ]
    }
  ],
  "dataResources": [
    {
      "code": "order",
      "name": "订单",
      "table": "orders",
      "attributes": [
        {
          "code": "ownerId",
          "name": "归属成员",
          "type": "uuid",
          "column": "owner_id"
        },
        {
          "code": "departmentPath",
          "name": "归属部门",
          "type": "ltree",
          "column": "department_path"
        },
        {
          "code": "amount",
          "name": "金额",
          "type": "number",
          "column": "amount"
        }
      ]
    }
  ],
  "dictionaries": [
    {
      "code": "customer-source",
      "name": "客户来源",
      "extensible": true,
      "items": [
        {
          "code": "online",
          "name": "线上"
        },
        {
          "code": "referral",
          "name": "转介绍"
        }
      ]
    }
  ],
  "parameters": [
    {
      "code": "order.auto-close",
      "name": "未支付订单自动关闭时长",
      "type": "duration",
      "default": "PT30M",
      "min": "PT5M",
      "max": "P3D",
      "tenantEditable": true
    }
  ]
}
